# Copy to .env for local development. On Vercel, set these under
# Project Settings → Environment Variables instead (never commit .env).

# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# (port 6543). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional: Supabase's CA certificate (PEM) to fully verify the TLS connection.
# DATABASE_CA_CERT=

# Supabase → Project Settings → API. The service-role key is secret: server only.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
