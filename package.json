{
  "name": "dys-learn",
  "version": "0.1.0",
  "description": "DysLearn: AI-based tutor prototype for lower primary pupils with learning difficulties",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "setup": "npm run db:migrate && npm run seed"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.18.0",
    "pg": "^8.23.1"
  }
}
